<Window x:Class="Facienda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Facienda"
        mc:Ignorable="d"
        Title="Facienda 1.0.2" Height="640" Width="960"
        MinWidth="500" MinHeight="300"
        Background="{DynamicResource App.Background}"
        Icon="icon.ico"
        Closing="MainWindow_Closing">

    <!-- =========================================================
         Resources (Colors, Brushes, Styles)
         ========================================================= -->
    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="AccentBlue.Color">#3A7BFF</Color>
        <Color x:Key="AccentBlueDark.Color">#2D64CC</Color>
        <Color x:Key="SidebarBg.Color">#0F172A</Color>
        <Color x:Key="SidebarSeparator.Color">#1F2A44</Color>
        <Color x:Key="SurfaceBg.Color">#FFFFFF</Color>
        <Color x:Key="SurfaceAltBg.Color">#F6F8FB</Color>
        <Color x:Key="TextPrimary.Color">#0B1220</Color>
        <Color x:Key="TextSecondary.Color">#5A6478</Color>
        <Color x:Key="Border.Color">#E5E7EB</Color>
        <Color x:Key="CardShadow.Color">#33000000</Color>
        <Color x:Key="Done.Color">#22C55E</Color>
        <Color x:Key="Todo.Color">#CBD5E1</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlue.Color}"/>
        <SolidColorBrush x:Key="AccentBlueDark" Color="{StaticResource AccentBlueDark.Color}"/>
        <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource SidebarBg.Color}"/>
        <SolidColorBrush x:Key="SidebarSeparator" Color="{StaticResource SidebarSeparator.Color}"/>
        <SolidColorBrush x:Key="App.Background" Color="{StaticResource SurfaceAltBg.Color}"/>
        <SolidColorBrush x:Key="App.Surface" Color="{StaticResource SurfaceBg.Color}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimary.Color}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondary.Color}"/>
        <SolidColorBrush x:Key="App.Border" Color="{StaticResource Border.Color}"/>
        <SolidColorBrush x:Key="CardShadow" Color="{StaticResource CardShadow.Color}"/>
        <SolidColorBrush x:Key="DoneBrush" Color="{StaticResource Done.Color}"/>
        <SolidColorBrush x:Key="TodoBrush" Color="{StaticResource Todo.Color}"/>

        <!-- Typography -->
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlueDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Tab Item Style (ListBoxItem) -->
        <Style x:Key="SidebarTabItem" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,4,6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9E1F2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="indicator" Grid.Column="0" Background="Transparent" CornerRadius="8,0,0,8"/>
                                <ContentPresenter Grid.Column="1" Margin="10,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#1B2541"/>
                                <Setter TargetName="indicator" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#162036"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Card -->
        <Style x:Key="ActionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource App.Surface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#66000000" BlurRadius="8" ShadowDepth="1" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ActionCardTemplate">
            <Border Style="{StaticResource ActionCard}"
                    MouseLeftButtonDown="ActionCard_Click">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename" Click="ActionRename_Click" />
                        <MenuItem Header="Delete" Click="ActionDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12,0,0,12" Margin="-12,-12,12,-12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource TodoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DoneBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,2,4,2">
                        <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Task Tab -->
        <DataTemplate x:Key="TaskTabContentTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ActionsHost"/>
            </ScrollViewer>
        </DataTemplate>

        <!-- Hidden TabControl look (headers collapsed) -->
        <Style x:Key="HiddenTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- TabItem with Menu -->
        <ContextMenu x:Key="TaskItemContextMenu">
            <MenuItem Header="Rename" Click="TaskRename_Click" />
            <MenuItem Header="Delete" Click="TaskDelete_Click" />
        </ContextMenu>

        <Style x:Key="SidebarTabItemWithMenu"
            TargetType="ListBoxItem"
            BasedOn="{StaticResource SidebarTabItem}">
            <Setter Property="ContextMenu" Value="{StaticResource TaskItemContextMenu}" />
        </Style>

    </Window.Resources>

    <!-- =========================================================
         Layout
         ========================================================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Header: App Title / Logo -->
            <Border Background="Transparent" Padding="16,18,16,12" BorderBrush="{StaticResource SidebarSeparator}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Simple logo: blue dot -->
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="0,0,8,0"/>
                    <TextBlock Text="Facienda" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </DockPanel>
            </Border>

            <!-- Tabs (ListBox) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="SidebarTabs" Background="Transparent" BorderThickness="0" Padding="6" ItemsSource="{Binding Tasks}"
                         ItemContainerStyle="{StaticResource SidebarTabItemWithMenu}"
                         MouseDoubleClick="SidebarTabs_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TaskItem}">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- Sidebar Footer: Add Task + Settings -->
            <Border Grid.Row="2" Padding="12" BorderBrush="{StaticResource SidebarSeparator}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PrimaryButton}" Content="+ Task" FontSize="14" Height="36" Click="NewTask_Button_Click"/>
                    <!-- Settings (gear) -->
                    <Button Grid.Column="1" Width="36" Height="36" Background="#1B2541" BorderThickness="0" Cursor="Hand">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="#D9E1F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="{StaticResource App.Background}">
            <Grid.RowDefinitions>
                <!-- Optional top stripe / toolbar placeholder (kept minimal) -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Content Header: Title + Add Action -->
            <Border Grid.Row="0" Background="Transparent" Padding="20,16,20,12" BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                               Text="{Binding ElementName=SidebarTabs, Path=SelectedItem.Name}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButton}" Content="Clear" FontSize="14"
                                Height="36" Width="80" Margin="0,0,8,0"
                                Click="ClearActions_Button_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="+ Action" FontSize="14"
                                Height="36" Width="80"
                                Click="NewAction_Button_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TabContent region (XAML-only switching via SelectedIndex binding) -->
            <Grid Grid.Row="1">
                <TabControl x:Name="ContentTabs"
                    ItemsSource="{Binding Tasks}"
                    SelectedIndex="{Binding ElementName=SidebarTabs, Path=SelectedIndex}"
                    Style="{StaticResource HiddenTabs}"
                    Margin="20">

                    <!-- ヘッダーだけ隠す -->
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.Resources>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Actions}"
                              ItemTemplate="{StaticResource ActionCardTemplate}" />
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
